    <ClCompile Include="..\native\SentenceCharacterRanks.cpp" />
    <ClCompile Include="..\native\SentenceNgram.cpp" />
    <ClCompile Include="..\native\SentenceFivegram.cpp" />
    <ClCompile Include="..\native\AddWord.cpp" />
    <ClCompile Include="..\native\LexiconSerialize.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup><ClCompile><MultiProcessorCompilation>true</MultiProcessorCompilation></ClCompile></ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
