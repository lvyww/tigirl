<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NativeProbeName>mode_unset_compartment_probe</NativeProbeName>
    <ModeCompartmentsSource Condition="'$(ModeCompartmentsSource)'==''">..\native\tsf\ModeCompartments.cpp</ModeCompartmentsSource>
  </PropertyGroup>
  <Import Project="DictionaryProbe.vcxproj" />
  <PropertyGroup Condition="'$(ModeUnsetOutputRoot)'!=''">
    <OutDir>$(ModeUnsetOutputRoot)\bin\</OutDir>
    <IntDir>$(ModeUnsetOutputRoot)\obj\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Remove="dictionary_probe.cpp" /><ClCompile Remove="..\native\Dictionary.cpp" />
    <ClCompile Include="$(ModeCompartmentsSource)" /><ClCompile Include="mode_unset_compartment_probe.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup><Link><AdditionalDependencies>user32.lib;ole32.lib;oleaut32.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies></Link></ItemDefinitionGroup>
</Project>
